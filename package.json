{
  "name": "nightjar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @nightjar/server test:api",
    "test:e2e": "playwright test",
    "check:acs": "node scripts/check-acs.ts",
    "verify": "node scripts/verify.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.10",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "8.23.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.2"
  },
  "version": "0.3.0"
}
